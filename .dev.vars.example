# Copy to .dev.vars for local development. Never commit .dev.vars.
ADMIN_TOKEN="dev-understory-token"
ENVIRONMENT="development"
SITE_URL="http://localhost:8790"
SEED_ON_START="false"
# Optional Access assertion verification; the editorial token is still required.
REQUIRE_ACCESS_JWT="false"
